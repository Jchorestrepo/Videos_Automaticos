# ==============================================================================
# CONFIGURACIÓN DE APIS Y MODELOS (MULTI-PROVEEDOR)
# Puedes usar cualquiera de los que tengas saldo disponible:
# ==============================================================================

# 1. OpenAI (DALL-E 3 para imágenes 16:9 hiperrealistas + GPT-4o para guiones)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 2. OpenRouter (Acceso a todos los modelos: Flux, Claude, DeepSeek, etc.)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 3. DeepSeek (Guiones ultra económicos y de alto razonamiento)
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 4. Google Gemini (Si activas facturación en el futuro)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 5. Configuración de Puertos
PORT=3001
VITE_PORT=5173

# 6. ElevenLabs (Opcional para locución de voz)
ELEVENLABS_API_KEY=
